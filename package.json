{
  "name": "on-mimacro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev --hostname 127.0.0.1 --port 3006",
    "build": "node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3006",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "format": "node node_modules/prettier/bin/prettier.cjs --write src scripts tests next.config.ts package.json",
    "db:init": "node scripts/local-db.mjs init",
    "db:start": "node scripts/local-db.mjs start",
    "db:stop": "node scripts/local-db.mjs stop",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "db:import": "node --import tsx scripts/import-bank.ts",
    "verify": "npm test && npm run typecheck && npm run build",
    "db:import-media": "node --import tsx scripts/import-media.ts",
    "admin:role": "node --import tsx scripts/admin-role.ts",
    "smoke:admin": "node scripts/smoke-admin.mjs",
    "local": "node scripts/with-local-db.mjs",
    "smoke:workspace": "node scripts/smoke-admin-workspace.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@next/env": "16.4.2",
    "lucide-react": "^0.468.0",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
