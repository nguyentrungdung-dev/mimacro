# Server only. Use the project database configured for this environment. Never commit credentials.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR_DB_HOST:5432/YOUR_DB?sslmode=verify-full
APP_ORIGIN=http://127.0.0.1:3006
PRIVATE_STORAGE_DIR=.local/storage
# Vercel: postgres (run db:import-media against the remote DB first).
MEDIA_STORAGE=postgres
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# No AI calls until a task/model/budget is configured.
AI_ENABLED=false
