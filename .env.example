# Server only; use a separate local PostgreSQL instance. npm run db:init creates .env.local.
DATABASE_URL=postgresql://mimacro:CHANGE_ME@127.0.0.1:55438/mimacro
APP_ORIGIN=http://127.0.0.1:3006
PRIVATE_STORAGE_DIR=.local/storage
# Vercel: postgres (run db:import-media against the remote DB first).
MEDIA_STORAGE=local
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# No AI calls until a task/model/budget is configured.
AI_ENABLED=false
